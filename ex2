#include <avr/io.h>         
#include <util/delay.h>     

void all_off(void){
  PORTE &= ~0x38;
  PORTG &= ~0x20;
}
void led_on(uint8_t n) {
  all_off();
  switch(n){
    case 0: PORTE |= 0x10; break;
    case 1: PORTE |= 0x20; break;
    case 2: PORTG |= 0x20; break;
    case 3: PORTE |= 0x08; break;
  }
}
int main(void) {
  DDRE |= 0x08; //D5
  DDRE |= 0x10; //D2
  DDRE |= 0x20; //D3
  DDRG |= 0x20; //D4
  DDRJ &= ~0x02; //D14
  uint8_t n=0;
  uint8_t state_pre=0; state_cur;

  led_on(0);
  while(1) {
    state_cur = (PINJ>>1) & 0x02;
    if (state_cur==1 && state_pre==0) {
      _delay_ms(5);
      n= (n+1)%4
      led_on(n);
    }
    state_pre= state_cur
  }
  return 0;
}
